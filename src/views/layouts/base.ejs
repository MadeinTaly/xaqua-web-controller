  <script>
    (function() {
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <script>
    // Dietro il tunnel Cloudflare l'app è protetta da Cloudflare Access: quando la
    // sessione scade, le fetch AJAX seguono il redirect e ricevono l'HTML della pagina
    // di login. Senza questo guard il JS fa response.json() su dell'HTML e l'interfaccia
    // si rompe in silenzio con "Unexpected token '<'".
    (function() {
      var origFetch = window.fetch.bind(window);
      var warned = false;
      function sessionExpired() {
        if (warned) return;
        warned = true;
        var bar = document.createElement('div');
        bar.style.cssText = 'position:fixed;left:0;right:0;top:0;z-index:9999;padding:12px;'
          + 'background:#b91c1c;color:#fff;font:600 14px system-ui;text-align:center;cursor:pointer';
        bar.textContent = 'Sessione Cloudflare Access scaduta — tocca qui per rientrare';
        bar.onclick = function() { window.location.reload(); };
        (document.body || document.documentElement).appendChild(bar);
      }
      window.fetch = function(input, init) {
        return origFetch(input, init).then(function(res) {
          var url = res.url || '';
          var isApi = typeof input === 'string' && input.indexOf('/api') === 0;
          var ct = res.headers.get('content-type') || '';
          if (isApi && (url.indexOf('cloudflareaccess.com') !== -1
              || (res.ok && ct.indexOf('text/html') !== -1))) {
            sessionExpired();
            throw new Error('Sessione scaduta: autenticazione Cloudflare Access richiesta');
          }
          return res;
        });
      };
    })();
  </script>
