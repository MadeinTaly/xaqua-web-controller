  <script src="/js/ambient.js?v=organic-2"></script>
  <script src="/js/main.js"></script>
  <script>
    (function() {
      var dot  = document.getElementById('status-dot');
      var text = document.getElementById('status-text');
      var mdot = document.getElementById('status-dot-mobile');
      if (!dot && !mdot) return;
      function setStatus(color, label) {
        if (dot) { dot.className = 'w-2 h-2 rounded-full ' + color + ' shrink-0'; }
        if (mdot) { mdot.className = 'w-2 h-2 rounded-full ' + color + ' shrink-0'; }
        if (text) { text.textContent = label; }
      }
      function checkStatus() {
        var ctrl = new AbortController();
        var timer = setTimeout(function() { ctrl.abort(); }, 5000);
        fetch('/api/ping', { signal: ctrl.signal })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            clearTimeout(timer);
            setStatus(data.online ? 'bg-emerald-400' : 'bg-red-400', data.online ? (data.name || 'Connesso') : 'Non connesso');
          })
          .catch(function(err) {
            clearTimeout(timer);
            setStatus(err.name === 'AbortError' ? 'bg-yellow-400' : 'bg-gray-400', err.name === 'AbortError' ? 'Timeout' : 'Non configurato');
          });
      }
      setStatus('bg-gray-400', 'Connessione...');
      checkStatus();
      setInterval(checkStatus, 30000);
    })();

    // Power toggle — init + handler
    (function() {
      var dt = document.getElementById('power-toggle');
      var mb = document.getElementById('power-toggle-mobile');
      var ml = document.getElementById('power-label-mobile');
      if (!dt) return;

      // Init: leggi stato da API
      fetch('/api/power').then(function(r){return r.json();}).then(function(d) {
        var isOn = !d.lampOff;
        dt.checked = isOn;
        if (mb) { mb.checked = isOn; }
        if (ml) { ml.textContent = isOn ? 'ON' : 'OFF'; ml.className = 'text-[9px] font-medium mt-0.5 ' + (isOn ? 'text-emerald-500' : 'text-gray-400 dark:text-gray-500'); }
      }).catch(function(){});

      // Handler globale
      window.togglePower = function(isOn) {
        dt.checked = isOn;
        if (mb) mb.checked = isOn;
        if (ml) { ml.textContent = isOn ? 'ON' : 'OFF'; ml.className = 'text-[9px] font-medium mt-0.5 ' + (isOn ? 'text-emerald-500' : 'text-gray-400 dark:text-gray-500'); }
        fetch('/api/power', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ on: isOn })
        }).then(function(r){return r.json();}).then(function(d) {
          if (d.ok) showToast(isOn ? 'Lampada accesa' : 'Lampada spenta', 'success');
          else showToast('Errore', 'error');
        }).catch(function(){ showToast('Errore di connessione', 'error'); });
      };
    })();
  </script>
